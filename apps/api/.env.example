# Copy to .env and fill in real values: cp .env.example .env
# Read by Nest (ConfigModule), the TypeORM CLI (data-source.ts) and docker-compose (env_file).

# Database host for the api. Use "postgres" if the api itself runs inside docker compose.
DB_HOST=localhost

# Postgres reads these only on first start with an empty volume.
# To change them later: docker compose down -v (wipes the data), then up again.
POSTGRES_USER=kanban
POSTGRES_PASSWORD=change_me
POSTGRES_DB=kanban
POSTGRES_PORT=5432
